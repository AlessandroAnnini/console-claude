{
  "name": "console-claude",
  "private": true,
  "version": "0.3.2",
  "description": "Unofficial DevTools REPL. Not affiliated with Anthropic. Type a goal; Claude inspects the live page.",
  "license": "AGPL-3.0",
  "author": "Alessandro Annini",
  "homepage": "https://alessandroannini.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlessandroAnnini/console-claude.git"
  },
  "bugs": {
    "url": "https://github.com/AlessandroAnnini/console-claude/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/watch.mjs",
    "build": "vite build && vite build --config vite.stub.config.ts && vite build --config vite.isolated.config.ts && vite build --config vite.background.config.ts",
    "pack": "npm run build && node scripts/pack.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "lint": "tsc --noEmit && eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.1.4",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
