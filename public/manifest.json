{
  "manifest_version": 3,
  "name": "Console Claude",
  "version": "0.1.0",
  "description": "Agentic REPL in the page console",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "action": {
    "default_title": "Console Claude"
  }
}
